#!/usr/bin/env bash
# henv — HEP virtual environment manager
# https://github.com/matplo/henv
HENV_VERSION="0.5.2"
HENV_SCRIPT_URL="https://raw.githubusercontent.com/matplo/henv/main/henv"
HENV_DEFAULT_DIR="$HOME/.henvs"

# ─── Utilities ────────────────────────────────────────────────────────────────

die()  { echo "[henv] ERROR: $*" >&2; exit 1; }
info() { [ "$HENV_QUIET" = true ] || echo "[henv] $*"; }
warn() { echo "[henv] WARNING: $*" >&2; }
command_exists() { command -v "$1" >/dev/null 2>&1; }

_system_has_cppyy() {
    # Returns true only when HENV_SYSTEM_PACKAGES_DIR is set AND its registry.json
    # contains a cppyy entry built with --target (i.e. a cppyy/ package dir exists
    # directly in the registered prefix).
    [ -n "$HENV_SYSTEM_PACKAGES_DIR" ] || return 1
    local reg="$HENV_SYSTEM_PACKAGES_DIR/registry.json"
    grep -q '"cppyy"' "$reg" 2>/dev/null || return 1
    local prefix
    prefix=$(python3 -c "
import json
d=json.load(open('$reg'))
print(d.get('packages',{}).get('cppyy',{}).get('prefix',''))
" 2>/dev/null)
    [ -n "$prefix" ] && [ -d "$prefix/cppyy" ]
}

_maybe_fix_cppyy() {
    # Removes the venv's binary cppyy wheel when --no-cppyy is set explicitly,
    # or when a system-provided cppyy is auto-detected (_system_has_cppyy).
    # Returns 1 (does nothing) when neither applies. Shared by install_hepyy
    # (run right after installing cppyy/hepyy into a new env) and the
    # standalone --fix-cppyy command (run against any existing env).
    if [ "$HENV_NO_CPPYY" = true ] || _system_has_cppyy; then
        if [ "$HENV_NO_CPPYY" = true ]; then
            info "Removing binary cppyy wheel (--no-cppyy)"
        else
            info "Removing binary cppyy wheel (system cppyy found in $HENV_SYSTEM_PACKAGES_DIR)"
        fi
        "$HENV_PATH/bin/pip" uninstall -y \
            cppyy cppyy-backend cppyy-cling CPyCppyy 2>/dev/null || true
        return 0
    fi
    return 1
}

# ─── Name registry ────────────────────────────────────────────────────────────
# Tracks name -> path for every env henv knows about, global or local, so a
# name can be resolved from anywhere (not just $HOME/.henvs/NAME). Backed by
# a flat JSON file, read/written via small python3 snippets (same style as
# _system_has_cppyy / _list_json elsewhere in this script).
#
# Concurrency: plain read-modify-write with no locking. Fine for a personal/
# lab CLI used by one person at a time; two henv invocations racing to
# register different names at the same instant could clobber each other's
# write. Not addressed here.

_registry_file() {
    echo "$HENV_DEFAULT_DIR/registry.json"
}

_registry_get() {
    # Prints the registered path for NAME and returns 0, or prints nothing
    # and returns 1 if NAME isn't registered (or the registry doesn't exist).
    local name="$1" reg
    reg=$(_registry_file)
    [ -f "$reg" ] || return 1
    REGISTRY_FILE="$reg" REGISTRY_NAME="$name" python3 -c "
import json, os, sys
reg = os.environ['REGISTRY_FILE']
name = os.environ['REGISTRY_NAME']
try:
    d = json.load(open(reg))
except (OSError, ValueError):
    sys.exit(1)
path = d.get(name, {}).get('path', '')
if not path:
    sys.exit(1)
print(path)
"
}

_registry_set() {
    local name="$1" path="$2" reg
    reg=$(_registry_file)
    mkdir -p "$HENV_DEFAULT_DIR"
    REGISTRY_FILE="$reg" REGISTRY_NAME="$name" REGISTRY_PATH="$path" python3 -c "
import json, os
reg = os.environ['REGISTRY_FILE']
try:
    d = json.load(open(reg))
except (OSError, ValueError):
    d = {}
d[os.environ['REGISTRY_NAME']] = {'path': os.environ['REGISTRY_PATH']}
json.dump(d, open(reg, 'w'), indent=2)
"
}

_registry_remove() {
    local name="$1" reg
    reg=$(_registry_file)
    [ -f "$reg" ] || return 0
    REGISTRY_FILE="$reg" REGISTRY_NAME="$name" python3 -c "
import json, os
reg = os.environ['REGISTRY_FILE']
try:
    d = json.load(open(reg))
except (OSError, ValueError):
    d = {}
d.pop(os.environ['REGISTRY_NAME'], None)
json.dump(d, open(reg, 'w'), indent=2)
"
}

_registry_all() {
    # Prints "name<TAB>path", one per line, for every registered env.
    local reg
    reg=$(_registry_file)
    [ -f "$reg" ] || return 0
    REGISTRY_FILE="$reg" python3 -c "
import json, os
reg = os.environ['REGISTRY_FILE']
try:
    d = json.load(open(reg))
except (OSError, ValueError):
    d = {}
for name, entry in d.items():
    print(name + '\t' + entry.get('path', ''))
"
}

_read_toml_key() {
    # Extract a simple string value from a TOML file: key = "value" or key = 'value'
    local key="$1" toml="${2:-.hepyy.toml}"
    [ -f "$toml" ] || return 0
    grep -E "^\s*${key}\s*=" "$toml" \
        | head -1 \
        | sed -E "s/^\s*${key}\s*=\s*[\"']?([^\"'#]+)[\"']?\s*$/\1/"
}

# ─── Python / tool resolution ─────────────────────────────────────────────────

find_python() {
    local py
    if [ -n "$HENV_PYTHON_FLAG" ]; then
        py="$HENV_PYTHON_FLAG"
        [ -x "$py" ] || die "Python interpreter not found: $py"
    else
        py=$(command -v python3 2>/dev/null || command -v python 2>/dev/null || echo "")
        [ -n "$py" ] || die "No python3 found in PATH"
    fi
    local ver
    ver=$("$py" -c "import sys; print('%d.%d' % sys.version_info[:2])" 2>/dev/null) \
        || die "Cannot run: $py"
    local maj="${ver%%.*}" min="${ver#*.}"
    { [ "$maj" -ge 3 ] && [ "$min" -ge 8 ]; } || die "Python 3.8+ required, found $ver via $py"
    echo "$py"
}

detect_tool() {
    HENV_PYTHON=$(find_python)
    if command_exists uv; then
        HENV_TOOL="uv"
    elif command_exists virtualenv && virtualenv --version >/dev/null 2>&1; then
        HENV_TOOL="virtualenv"
    elif "$HENV_PYTHON" -m virtualenv --version >/dev/null 2>&1; then
        HENV_TOOL="virtualenv_module"
    else
        HENV_TOOL="venv"
    fi
}

# ─── Env path resolution ──────────────────────────────────────────────────────

resolve_env_path() {
    # No --name and no location is just "the env named 'default'" — fold it
    # into the --name branch below so it goes through the registry lookup
    # too (a moved/relocated default env is found the same way any other
    # named env would be, instead of always hardcoding $HENV_DEFAULT_DIR/default).
    [ -n "$HENV_NAME" ] || [ -n "$HENV_LOCATION" ] || HENV_NAME="default"

    if [ -n "$HENV_NAME" ]; then
        case "$HENV_NAME" in
            */*|.|..) die "Invalid --name: '$HENV_NAME' (must be a plain name, no '/' or '..')" ;;
        esac
    fi

    if [ -n "$HENV_LOCATION" ]; then
        # --name combined with a location is allowed: it creates/uses the env
        # at that exact path, registered under the given name instead of the
        # path's derived (basename) name.
        local base
        if [ "$HENV_LOCATION" = "." ]; then
            base="$PWD"
        elif [[ "$HENV_LOCATION" = /* ]]; then
            base="$HENV_LOCATION"
        else
            base="$PWD/$HENV_LOCATION"
        fi
        base=$(cd "$base" 2>/dev/null && pwd) || die "Directory not found: $HENV_LOCATION"
        HENV_PATH="$base/.venv"
        HENV_LABEL="${HENV_NAME:-$(basename "$base")}"
    elif [ -n "$HENV_NAME" ]; then
        # No location given: look the name up in the registry first, so a
        # previously-registered local env can be found from anywhere. Falls
        # back to the legacy $HOME/.henvs/NAME path for a name never seen
        # before (brand-new global env).
        local registered
        registered=$(_registry_get "$HENV_NAME") || true
        HENV_PATH="${registered:-$HENV_DEFAULT_DIR/$HENV_NAME}"
        HENV_LABEL="$HENV_NAME"
    fi

    # Reconcile against the registry. --name (explicit, or defaulted to
    # "default" above) is always authoritative and re-points the registry
    # entry; a name derived from a location refuses to silently collide with
    # an existing, differently-pathed registration — the caller has to pass
    # --name to pick a distinct name instead.
    local existing
    existing=$(_registry_get "$HENV_LABEL") || true
    if [ -n "$existing" ] && [ "$existing" != "$HENV_PATH" ]; then
        if [ -n "$HENV_NAME" ]; then
            info "Re-pointing name '$HENV_LABEL': $existing -> $HENV_PATH"
        else
            die "Name '$HENV_LABEL' is already registered to $existing — pass --name to use a distinct name for this env"
        fi
    fi

    if env_exists; then
        HENV_IS_NEW=false
        # Self-heal / confirm the mapping now that the path is known to be
        # real — also backfills envs created before the registry existed.
        [ "$existing" = "$HENV_PATH" ] || _registry_set "$HENV_LABEL" "$HENV_PATH"
    else
        HENV_IS_NEW=true
    fi

    # Auto-detect packages dirs from .hepyy.toml in CWD (flags take precedence)
    if [ -z "$HENV_PACKAGES_DIR" ]; then
        HENV_PACKAGES_DIR=$(_read_toml_key packages_dir) || true
    fi
    if [ -z "$HENV_SYSTEM_PACKAGES_DIR" ]; then
        HENV_SYSTEM_PACKAGES_DIR=$(_read_toml_key system_packages_dir) || true
    fi
}

env_exists() {
    [ -f "$HENV_PATH/bin/activate" ]
}

maybe_recreate() {
    if [ "$HENV_RECREATE" = true ] && [ "$HENV_IS_NEW" = false ]; then
        info "Recreating env '$HENV_LABEL' (--recreate)"
        rm -rf "$HENV_PATH"
        HENV_IS_NEW=true
    fi
}

# ─── Venv lifecycle ───────────────────────────────────────────────────────────

create_env() {
    detect_tool
    info "Creating env '$HENV_LABEL' at $HENV_PATH"
    info "Python: $HENV_PYTHON  Tool: $HENV_TOOL"
    mkdir -p "$(dirname "$HENV_PATH")"
    case "$HENV_TOOL" in
        uv)
            uv venv --seed --python "$HENV_PYTHON" "$HENV_PATH" || die "uv venv failed" ;;
        virtualenv)
            virtualenv -p "$HENV_PYTHON" "$HENV_PATH" || die "virtualenv failed" ;;
        virtualenv_module)
            "$HENV_PYTHON" -m virtualenv -p "$HENV_PYTHON" "$HENV_PATH" \
                || die "python -m virtualenv failed" ;;
        venv)
            "$HENV_PYTHON" -m venv "$HENV_PATH" || die "python -m venv failed" ;;
    esac
    bootstrap_pip
    [ "$HENV_NO_HEPYY" = true ] || install_hepyy
    _registry_set "$HENV_LABEL" "$HENV_PATH"
}

bootstrap_pip() {
    local py="$HENV_PATH/bin/python"

    if ! "$py" -m pip --version >/dev/null 2>&1; then
        info "Bootstrapping pip..."

        if [ "$HENV_TOOL" = "uv" ]; then
            uv pip install --python "$py" pip setuptools wheel \
                || die "Failed to install pip into virtual environment"
        else
            "$py" -m ensurepip --upgrade \
                || die "Failed to bootstrap pip"
        fi
    fi

    info "Upgrading pip, setuptools, and wheel..."
    "$py" -m pip install --upgrade pip setuptools wheel --quiet \
        || warn "pip upgrade failed (non-fatal)"
}

_venv_pip_install() {
    if [ "$HENV_TOOL" = "uv" ]; then
        uv pip install --python "$HENV_PATH" "$@"
    else
        "$HENV_PATH/bin/pip" install "$@"
    fi
}

install_hepyy() {
    # henv is predominantly used with hepyy, so both cppyy and hepyy are
    # installed by default on env creation. Skip with --no-hepyy / --nh.
    info "Installing cppyy..."
    _venv_pip_install cppyy || warn "cppyy install failed (non-fatal)"

    info "Installing hepyy..."
    _venv_pip_install hepyy || warn "hepyy install failed (non-fatal)"

    # Swap the binary cppyy wheel for a system build when one is registered
    # under --system-packages-dir (or --no-cppyy forces it regardless).
    _maybe_fix_cppyy || true

    local heyy="$HENV_PATH/bin/heyy"
    if [ -x "$heyy" ]; then
        info "Running heyy init..."
        "$heyy" init || warn "heyy init failed (non-fatal)"
        print_heyy_completion_tip
    else
        warn "heyy not found after install — skipping heyy init"
    fi
}

print_heyy_completion_tip() {
    [ "$HENV_QUIET" = true ] && return 0
    echo "[henv] For heyy tab completion in your normal shell (outside henv), add:"
    echo "  Bash — add to ~/.bashrc:"
    echo "    eval \"\$(heyy completion)\""
    echo "  Zsh — add to ~/.zshrc:"
    echo "    eval \"\$(heyy completion)\""
    echo "  Fish — add to ~/.config/fish/config.fish:"
    echo "    heyy completion --shell fish | source"
}

# ─── Activation ───────────────────────────────────────────────────────────────

launch_subshell() {
    local tmpfile
    tmpfile=$(mktemp /tmp/henv_init.XXXXXX)

    # First line of the init file cleans up the file itself
    cat > "$tmpfile" <<INITEOF
rm -f "$tmpfile"
# Source user's shell rc for aliases and PATH
if [ -f "\$HOME/.bashrc" ]; then
    source "\$HOME/.bashrc" 2>/dev/null
elif [ -f "\$HOME/.bash_profile" ]; then
    source "\$HOME/.bash_profile" 2>/dev/null
fi
# Activate the venv
source "$HENV_PATH/bin/activate"
${HENV_PACKAGES_DIR:+export HEPYY_PACKAGES_DIR="$HENV_PACKAGES_DIR"}
${HENV_SYSTEM_PACKAGES_DIR:+export HEPYY_SYSTEM_PACKAGES_DIR="$HENV_SYSTEM_PACKAGES_DIR"}
# Decorate prompt and export markers
export HENV_ACTIVE="$HENV_LABEL"
export HENV_PATH="$HENV_PATH"
PS1="(henv:$HENV_LABEL) \$PS1"
# Wire up heyy tools if available
if [ -x "$HENV_PATH/bin/heyy" ]; then
    # Tab completion for hepyy/heyy/her
    eval "\$($HENV_PATH/bin/heyy completion --shell bash 2>/dev/null)" 2>/dev/null
    # Regenerate TCL modulefiles for installed packages (silent; no-op if none)
    "$HENV_PATH/bin/heyy" generate-modules >/dev/null 2>&1 || true
    # Register the modulefiles dir with the system module command (if present)
    if command -v module >/dev/null 2>&1; then
        eval "\$($HENV_PATH/bin/heyy modules 2>/dev/null)" 2>/dev/null
    fi
fi
INITEOF

    # Banner is generated (or skipped) here, at write time, since the child
    # bash process doesn't share HENV_QUIET / the info() function.
    if [ "$HENV_QUIET" != true ]; then
        cat >> "$tmpfile" <<INITEOF
# Banner
echo ""
echo "[henv] active : $HENV_LABEL"
echo "[henv] path   : $HENV_PATH"
echo "[henv] python : \$(python --version 2>&1)"
if [ -x "$HENV_PATH/bin/heyy" ]; then
    echo "[henv] heyy   : \$($HENV_PATH/bin/heyy --version 2>/dev/null)"
fi
echo "[henv] type 'exit' or Ctrl-D to deactivate"
echo ""
INITEOF
    fi

    exec bash --init-file "$tmpfile"
}

cmd_print_activate() {
    resolve_env_path
    maybe_recreate
    [ "$HENV_IS_NEW" = true ] && create_env
    echo "source \"$HENV_PATH/bin/activate\""
    [ -n "$HENV_PACKAGES_DIR" ]        && echo "export HEPYY_PACKAGES_DIR=\"$HENV_PACKAGES_DIR\""
    [ -n "$HENV_SYSTEM_PACKAGES_DIR" ] && echo "export HEPYY_SYSTEM_PACKAGES_DIR=\"$HENV_SYSTEM_PACKAGES_DIR\""
    echo "export HENV_ACTIVE=\"$HENV_LABEL\""
    echo "export HENV_PATH=\"$HENV_PATH\""
    echo "PS1=\"(henv:$HENV_LABEL) \$PS1\""
    echo "if [ -x \"$HENV_PATH/bin/heyy\" ]; then"
    echo "    eval \"\$($HENV_PATH/bin/heyy completion --shell bash 2>/dev/null)\" 2>/dev/null"
    echo "    $HENV_PATH/bin/heyy generate-modules >/dev/null 2>&1 || true"
    echo "    command -v module >/dev/null 2>&1 && eval \"\$($HENV_PATH/bin/heyy modules 2>/dev/null)\" 2>/dev/null"
    echo "fi"
}

# ─── Commands ─────────────────────────────────────────────────────────────────

cmd_activate() {
    resolve_env_path
    maybe_recreate
    if [ "$HENV_IS_NEW" = true ]; then
        create_env
    else
        info "Activating existing env: $HENV_PATH"
    fi
    launch_subshell
}

cmd_run() {
    resolve_env_path
    maybe_recreate
    [ "$HENV_IS_NEW" = true ] && create_env
    [ "${#HENV_RUN_ARGS[@]}" -gt 0 ] || die "--run requires a command"
    local tmpfile
    tmpfile=$(mktemp /tmp/henv_run.XXXXXX)
    cat > "$tmpfile" <<INITEOF
rm -f "$tmpfile"
if [ -f "\$HOME/.bashrc" ]; then
    source "\$HOME/.bashrc" 2>/dev/null
elif [ -f "\$HOME/.bash_profile" ]; then
    source "\$HOME/.bash_profile" 2>/dev/null
fi
source "$HENV_PATH/bin/activate"
${HENV_PACKAGES_DIR:+export HEPYY_PACKAGES_DIR="$HENV_PACKAGES_DIR"}
${HENV_SYSTEM_PACKAGES_DIR:+export HEPYY_SYSTEM_PACKAGES_DIR="$HENV_SYSTEM_PACKAGES_DIR"}
export HENV_ACTIVE="$HENV_LABEL"
export HENV_PATH="$HENV_PATH"
if [ -x "$HENV_PATH/bin/heyy" ]; then
    "$HENV_PATH/bin/heyy" generate-modules >/dev/null 2>&1 || true
    if command -v module >/dev/null 2>&1; then
        eval "\$($HENV_PATH/bin/heyy modules 2>/dev/null)" 2>/dev/null
    fi
fi
INITEOF
    bash -c "source \"$tmpfile\" && $(printf '%q ' "${HENV_RUN_ARGS[@]}")"
}

cmd_update() {
    local self
    # Resolve real path of this script, handling symlinks
    if command_exists realpath; then
        self=$(realpath "$0")
    elif command_exists readlink; then
        self=$(readlink -f "$0" 2>/dev/null || echo "$0")
    else
        self="$0"
    fi
    [ -w "$self" ] || die "Cannot write to $self — check permissions or reinstall"
    info "Updating $self from $HENV_SCRIPT_URL ..."
    local tmp
    tmp=$(mktemp /tmp/henv_update.XXXXXX)
    if ! curl -fsSL "$HENV_SCRIPT_URL" -o "$tmp"; then
        rm -f "$tmp"
        die "Download failed"
    fi
    local first_line
    first_line=$(head -1 "$tmp")
    if [ "$first_line" != "#!/usr/bin/env bash" ]; then
        rm -f "$tmp"
        die "Downloaded file looks invalid (first line: $first_line)"
    fi
    chmod +x "$tmp"
    cp "$self" "$self.bak" 2>/dev/null || true
    mv "$tmp" "$self"
    info "Updated. Version: $("$self" --version 2>/dev/null || echo "unknown")"
    info "Previous version backed up to $self.bak"
}

cmd_install() {
    local prefix="${1:-$HOME/.local}"
    local bin_dir="$prefix/bin"
    mkdir -p "$bin_dir"
    local dest="$bin_dir/henv"
    info "Downloading $HENV_SCRIPT_URL → $dest"
    if ! curl -fsSL "$HENV_SCRIPT_URL" -o "$dest"; then
        die "Download failed"
    fi
    chmod +x "$dest"
    info "henv installed to $dest"
    case ":$PATH:" in
        *":$bin_dir:"*) ;;
        *)
            warn "$bin_dir is not in your PATH"
            echo "Add to your ~/.bashrc or ~/.zshrc:"
            echo "  export PATH=\"$bin_dir:\$PATH\""
            ;;
    esac
}

_env_rows() {
    # Prints "name<TAB>path<TAB>py_ver<TAB>complete" for every known env: every
    # registry entry, plus any dir directly under $HENV_DEFAULT_DIR not
    # already covered (back-compat for envs created before the registry
    # existed, or ones nobody's activated since).
    local seen=" " reg
    reg=$(_registry_all)
    if [ -n "$reg" ]; then
        local name path
        while IFS=$'\t' read -r name path; do
            [ -n "$name" ] || continue
            seen="$seen$name "
            if [ -f "$path/bin/activate" ]; then
                printf '%s\t%s\t%s\t%s\n' "$name" "$path" "$("$path/bin/python" --version 2>&1)" true
            else
                printf '%s\t%s\t%s\t%s\n' "$name" "$path" "" false
            fi
        done <<< "$reg"
    fi
    if [ -d "$HENV_DEFAULT_DIR" ]; then
        local dir name path
        for dir in "$HENV_DEFAULT_DIR"/*/; do
            [ -d "$dir" ] || continue
            name=$(basename "$dir")
            case "$seen" in *" $name "*) continue ;; esac
            path="${dir%/}"
            if [ -f "$dir/bin/activate" ]; then
                printf '%s\t%s\t%s\t%s\n' "$name" "$path" "$("$dir/bin/python" --version 2>&1)" true
            else
                printf '%s\t%s\t%s\t%s\n' "$name" "$path" "" false
            fi
        done
    fi
}

cmd_list() {
    [ "$HENV_JSON" = true ] && { _list_json; return; }
    local rows
    rows=$(_env_rows)
    if [ -z "$rows" ]; then
        info "No envs found"
        return
    fi
    info "Envs:"
    local name path py_ver complete
    while IFS=$'\t' read -r name path py_ver complete; do
        [ -n "$name" ] || continue
        if [ "$complete" = true ]; then
            printf "  %-24s  %-12s  %s\n" "$name" "$py_ver" "$path"
        else
            printf "  %-24s  %-12s  %s\n" "$name" "(incomplete)" "$path"
        fi
    done <<< "$rows"
}

_list_json() {
    _env_rows | python3 -c '
import json, sys
envs = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line:
        continue
    name, path, py_ver, complete = line.split("\t")
    envs.append({"name": name, "path": path, "python": py_ver, "complete": complete == "true"})
print(json.dumps(envs, indent=2))
'
}

cmd_info() {
    resolve_env_path
    [ -f "$HENV_PATH/bin/activate" ] || die "Env not found: $HENV_PATH"
    echo "name    : $HENV_LABEL"
    echo "path    : $HENV_PATH"
    echo "python  : $("$HENV_PATH/bin/python" --version 2>&1)"
    echo "size    : $(du -sh "$HENV_PATH" 2>/dev/null | cut -f1)"
    if [ -x "$HENV_PATH/bin/heyy" ]; then
        echo "heyy    : $("$HENV_PATH/bin/heyy" --version 2>/dev/null)"
        echo "packages: $("$HENV_PATH/bin/heyy" list 2>/dev/null | wc -l | tr -d ' ')"
    fi
    if [ "${HENV_ACTIVE:-}" = "$HENV_LABEL" ]; then
        echo "active  : yes (current shell)"
    fi
}

cmd_fix_cppyy() {
    # Not the same problem as heyy's own 'fix-cppyy' (which repairs broken
    # library paths in an already-installed cppyy). This instead removes the
    # binary cppyy wheel pip pulled into the venv when a system/HPC-shared
    # build already exists — the wheel doesn't work on every platform and
    # just shadows the working one heyy's loader would otherwise find via
    # HENV_SYSTEM_PACKAGES_DIR. install_hepyy already runs this once at env
    # creation; this is for re-running it later (e.g. --system-packages-dir
    # was only set/registered after the env already existed).
    resolve_env_path
    [ -f "$HENV_PATH/bin/activate" ] || die "Env not found: $HENV_PATH"

    if _maybe_fix_cppyy; then
        info "Done — cppyy will now resolve from the system build via heyy's loader."
    else
        info "No system cppyy detected under HENV_SYSTEM_PACKAGES_DIR (${HENV_SYSTEM_PACKAGES_DIR:-unset}) — nothing to fix."
        info "Pass --no-cppyy to force removal of the venv's binary cppyy wheel anyway."
    fi
}

cmd_mv() {
    # Not a byte-for-byte move: a plain 'mv' would leave stale absolute paths
    # baked into bin/activate* and every installed script's shebang (and
    # potentially RPATHs inside compiled cppyy libraries). Instead this
    # recreates the env fresh at the new path — cppyy/hepyy come back the
    # same way they would on any new env — then removes the old one and
    # re-points the registry. Packages installed beyond cppyy/hepyy are NOT
    # carried over; reinstall them after.
    resolve_env_path
    [ -f "$HENV_PATH/bin/activate" ] || die "Env not found: $HENV_PATH"

    local old_path="$HENV_PATH"
    local new_path="$HENV_MV_TARGET"
    case "$new_path" in
        /*) : ;;
        *)  new_path="$PWD/$new_path" ;;
    esac
    mkdir -p "$(dirname "$new_path")" || die "Cannot create parent of $new_path"
    new_path="$(cd "$(dirname "$new_path")" && pwd)/$(basename "$new_path")"

    [ "$new_path" != "$old_path" ] || die "--mv target is the same as the current path"
    if [ -e "$new_path" ]; then
        [ "$HENV_YES" = true ] || die "$new_path already exists — pass --yes to overwrite it"
        rm -rf "$new_path"
    fi

    warn "Recreating (not copying) '$HENV_LABEL' at the new path — packages beyond cppyy/hepyy are not preserved"
    HENV_PATH="$new_path"
    create_env

    rm -rf "$old_path"
    info "Moved '$HENV_LABEL': $old_path -> $new_path"
}

cmd_delete() {
    resolve_env_path
    [ -d "$HENV_PATH" ] || die "Env not found: $HENV_PATH"
    local answer
    if [ "$HENV_YES" = true ]; then
        answer="y"
    else
        printf "[henv] Delete %s? [y/N] " "$HENV_PATH"
        read -r answer
        answer="${answer:-n}"
    fi
    case "$answer" in
        y|Y|yes|YES)
            rm -rf "$HENV_PATH"
            local existing
            existing=$(_registry_get "$HENV_LABEL") || true
            [ "$existing" != "$HENV_PATH" ] || _registry_remove "$HENV_LABEL"
            info "Deleted $HENV_PATH" ;;
        *)
            info "Aborted" ;;
    esac
}

cmd_help() {
    cat <<'EOF'
henv — HEP virtual environment manager

USAGE:
  henv [OPTIONS] [LOCATION]

LOCATION:
  (none)           global env: $HOME/.henvs/default
  .                local env:  $PWD/.venv
  /abs/path        local env:  /abs/path/.venv
  rel/path         local env:  $PWD/rel/path/.venv

OPTIONS:
  --name NAME / -n NAME      named env: registered NAME, or $HOME/.henvs/NAME if new
  --global         explicit global default (same as no LOCATION)
  --python PATH    explicit Python interpreter
  --run CMD ... / -x CMD ...   run CMD inside env, no interactive subshell
  --update         self-update henv from GitHub
  --install        install henv to ~/.local/bin (for piped curl usage)
  --print-activate emit 'source ...' lines for eval
  --list           list all known envs (registry + $HOME/.henvs/)
  --list --json    list envs as a JSON array (name, path, python, complete)
  --delete         delete the resolved env (and its registry entry)
  --info           print diagnostics for the resolved env (path, python, size, heyy)
  --recreate       delete and rebuild the resolved env before activating/running
  --mv NEWPATH     recreate the resolved env at NEWPATH and update the registry
                   (fresh env, not a byte-for-byte move — see MOVING AN ENV below)
  --packages-dir PATH        set HEPYY_PACKAGES_DIR (user-writable package store)
  --system-packages-dir PATH set HEPYY_SYSTEM_PACKAGES_DIR (read-only shared base)
  --fix-cppyy                remove the venv's binary cppyy wheel if a system
                              build is found under --system-packages-dir
  --no-cppyy                 force --fix-cppyy's removal even without a detected
                              system cppyy
  --no-hepyy / --nh          skip installing cppyy + hepyy on env creation
  --yes / -y                 non-interactive; auto-answer yes to prompts
  --quiet / -q               suppress [henv] info banners (warnings/errors still shown)
  --version                  print version string
  -h / --help                this help

New envs get cppyy and hepyy (https://pypi.org/project/hepyy/) installed by
default, since henv is predominantly used with hepyy — pass --no-hepyy / --nh
for a bare venv with neither. Whenever heyy ends up present in the venv
(installed by henv or by hand), henv wires up its completion/modulefiles
automatically inside the henv subshell/--run. Right after heyy is installed,
henv also prints the one-liner to add heyy's own completion to your normal
shell rc (outside henv) — see SHELL INTEGRATION below.

NAME REGISTRY:
  Every env — global (--name) or local (henv . / henv path) — is recorded in
  $HOME/.henvs/registry.json under a name: the one --name gives explicitly,
  or (for a location) the directory's basename, or "default" when neither is
  given. Once registered, --name resolves that env from anywhere:
    cd ~/proj/backend && henv .        # registers 'backend' -> ~/proj/backend/.venv
    cd / && henv --name backend --info # finds it from any directory
  A name derived from a location that collides with a different, already-
  registered path is refused (pass --name explicitly to disambiguate); an
  explicit --name always wins and re-points the registry if needed.

MOVING AN ENV:
  henv --name backend --mv /new/path/backend-env
  This does not copy files — venvs bake absolute paths into bin/activate*
  and every installed script's shebang, so a plain 'mv' would break them
  (cppyy can also embed absolute RPATHs). --mv instead deletes the old env
  and recreates a fresh one at the new path (cppyy/hepyy reinstalled the
  same as any new env), then updates the registry. Packages installed
  beyond cppyy/hepyy are NOT preserved — reinstall them after.

PACKAGE SHARING (HPC / shared filesystems):
  henv --system-packages-dir /shared/hep/packages .
    # User packages go to .venv/hepyy_packages/ (writable)
    # Shared pre-built packages are visible read-only from /shared/hep/packages
    # 'heyy install mypkg' writes to user dir; shared packages load from /shared/

  # Or configure in .hepyy.toml (auto-detected by henv):
  #   packages_dir = "~/.hepyy_packages"
  #   system_packages_dir = "/shared/hep/packages"

  # If 'pip install cppyy' (pulled in by hepyy) doesn't work on this platform
  # and a system build is already shared, drop the venv's copy in favor of it:
  henv --name old-env --system-packages-dir /shared/hep/packages --fix-cppyy
  # (--fix-cppyy is unrelated to heyy's own 'fix-cppyy', which repairs broken
  # library paths in an already-installed cppyy rather than swap it out)

EXAMPLES:
  henv                            # global default env (installs cppyy + hepyy)
  henv .                          # local .venv in current directory
  henv --name hep2026             # named global env
  henv -n hep2026                 # -n is a short alias for --name
  henv . --run python script.py   # run without subshell
  henv --name bare --no-hepyy     # plain venv, no cppyy/hepyy

  # Activate in current shell (no subshell):
  eval "$(henv --print-activate .)"

INSTALL (one-liner):
  curl -fsSL https://raw.githubusercontent.com/matplo/henv/main/henv \
    -o ~/.local/bin/henv && chmod +x ~/.local/bin/henv

  # Or self-installing (also checks PATH):
  curl -fsSL https://raw.githubusercontent.com/matplo/henv/main/henv | bash -s -- --install

SHELL INTEGRATION (add to ~/.bashrc):
  hactivate() { eval "$(henv --print-activate "$@")"; }

  # heyy tab completion in your normal shell (printed after heyy installs):
  #   Bash (~/.bashrc) / Zsh (~/.zshrc):  eval "$(heyy completion)"
  #   Fish (~/.config/fish/config.fish):  heyy completion --shell fish | source
EOF
}

# ─── Argument parsing ─────────────────────────────────────────────────────────

HENV_NAME=""
HENV_LOCATION=""
HENV_PYTHON_FLAG=""
HENV_YES=false
HENV_SUBCOMMAND="activate"
HENV_RUN_ARGS=()
HENV_INSTALL_PREFIX=""
HENV_MV_TARGET=""
HENV_PACKAGES_DIR="${HEPYY_PACKAGES_DIR:-}"
HENV_SYSTEM_PACKAGES_DIR="${HEPYY_SYSTEM_PACKAGES_DIR:-}"
HENV_RECREATE=false
HENV_QUIET=false
HENV_JSON=false
HENV_NO_CPPYY=false
HENV_NO_HEPYY=false

while [ $# -gt 0 ]; do
    case "$1" in
        --name|-n)
            [ -n "${2:-}" ] || die "--name requires a value"
            HENV_NAME="$2"; shift 2 ;;
        --name=*)
            HENV_NAME="${1#--name=}"; shift ;;
        --python)
            [ -n "${2:-}" ] || die "--python requires a value"
            HENV_PYTHON_FLAG="$2"; shift 2 ;;
        --python=*)
            HENV_PYTHON_FLAG="${1#--python=}"; shift ;;
        --global)
            shift ;;
        --run)
            HENV_SUBCOMMAND="run"; shift
            HENV_RUN_ARGS=("$@"); break ;;
        -x)
            HENV_SUBCOMMAND="run"; shift
            HENV_RUN_ARGS=("$@"); break ;;
        --update)
            HENV_SUBCOMMAND="update"; shift ;;
        --install)
            HENV_SUBCOMMAND="install"; shift
            HENV_INSTALL_PREFIX="${1:-}"; break ;;
        --print-activate)
            HENV_SUBCOMMAND="print_activate"; shift ;;
        --list)
            HENV_SUBCOMMAND="list"; shift ;;
        --delete)
            HENV_SUBCOMMAND="delete"; shift ;;
        --info)
            HENV_SUBCOMMAND="info"; shift ;;
        --fix-cppyy)
            HENV_SUBCOMMAND="fix_cppyy"; shift ;;
        --mv)
            [ -n "${2:-}" ] || die "--mv requires a target path"
            HENV_SUBCOMMAND="mv"; HENV_MV_TARGET="$2"; shift 2 ;;
        --recreate)
            HENV_RECREATE=true; shift ;;
        --quiet|-q)
            HENV_QUIET=true; shift ;;
        --json)
            HENV_JSON=true; shift ;;
        --no-cppyy)
            HENV_NO_CPPYY=true; shift ;;
        --no-hepyy|--nh)
            HENV_NO_HEPYY=true; shift ;;
        --packages-dir)
            [ -n "${2:-}" ] || die "--packages-dir requires a value"
            HENV_PACKAGES_DIR="$2"; shift 2 ;;
        --packages-dir=*)
            HENV_PACKAGES_DIR="${1#--packages-dir=}"; shift ;;
        --system-packages-dir)
            [ -n "${2:-}" ] || die "--system-packages-dir requires a value"
            HENV_SYSTEM_PACKAGES_DIR="$2"; shift 2 ;;
        --system-packages-dir=*)
            HENV_SYSTEM_PACKAGES_DIR="${1#--system-packages-dir=}"; shift ;;
        --yes|-y)
            HENV_YES=true; shift ;;
        --version)
            HENV_SUBCOMMAND="version"; shift ;;
        -h|--help)
            HENV_SUBCOMMAND="help"; shift ;;
        --)
            shift; break ;;
        -*)
            die "Unknown option: $1 (try --help)" ;;
        *)
            [ -z "$HENV_LOCATION" ] || die "Unexpected argument: '$1' (location already set to '$HENV_LOCATION')"
            HENV_LOCATION="$1"; shift ;;
    esac
done

# ─── Dispatch ─────────────────────────────────────────────────────────────────

case "$HENV_SUBCOMMAND" in
    activate)       cmd_activate ;;
    run)            cmd_run ;;
    update)         cmd_update ;;
    install)        cmd_install "$HENV_INSTALL_PREFIX" ;;
    print_activate) cmd_print_activate ;;
    list)           cmd_list ;;
    delete)         cmd_delete ;;
    info)           cmd_info ;;
    fix_cppyy)      cmd_fix_cppyy ;;
    mv)             cmd_mv ;;
    help)           cmd_help ;;
    version)        echo "henv $HENV_VERSION" ;;
    *)              die "Unknown subcommand: $HENV_SUBCOMMAND" ;;
esac
